{
  "name": "@soffits/dsh-card-board",
  "version": "0.3.0",
  "description": "A data-driven card board for DeepSeek Harness: scripts write small JSON cards, the Web UI shows each person the boards they may see.",
  "type": "module",
  "license": "MIT",
  "author": "Sakina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-card-board.git"
  },
  "homepage": "https://github.com/soffits/dsh-card-board#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-card-board/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dashboard",
    "cards",
    "charts"
  ],
  "main": "./index.js",
  "bin": {
    "dsh-card-board": "./bin/dsh-card-board.js"
  },
  "exports": {
    ".": "./index.js",
    "./schema": "./src/schema.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "client.js",
    "client.actions.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "check": "for f in index.js client.js bin/*.js src/*.js test/*.js; do node --check \"$f\" || exit 1; done && node bin/dsh-card-board.js check --dir examples/boards",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1"
  }
}
